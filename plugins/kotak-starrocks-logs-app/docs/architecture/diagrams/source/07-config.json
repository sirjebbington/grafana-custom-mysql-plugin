  "cards": [
    {
      "dot": "cyan",
      "title": "The tenant is the view",
      "items": [
        "vw_eks_app_logs_<app_id>: Ranger decides who reads it",
        "tenants is keyed by app_id (or <datasourceUid>/<app_id>) and holds display settings only",
        "Loki header app-01996-x equals StarRocks app_id app_01996_x"
      ]
    },
    {
      "dot": "emerald",
      "title": "Validation",
      "items": [
        "Invalid entries are dropped one by one and listed on the configuration page",
        "Regexes must compile (and have a capture group where one is needed)",
        "Without any provisioning the app still runs with defaults"
      ]
    },
    {
      "dot": "amber",
      "title": "After Loki is removed",
      "items": [
        "The generator is a one-time bootstrap",
        "The provisioning file in deploy-config becomes the only source and is edited directly"
      ]
    }
  ]
