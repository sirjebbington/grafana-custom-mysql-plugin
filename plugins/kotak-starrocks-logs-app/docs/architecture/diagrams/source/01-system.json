  "cards": [
    {
      "dot": "rose",
      "title": "Identity",
      "items": [
        "Grafana attaches the user's IDAM tokens to every /api/ds/query call",
        "The data source logs in to StarRocks as that user, the JWT is the password",
        "Ranger allows or denies per view; the app adds no access path"
      ]
    },
    {
      "dot": "cyan",
      "title": "Where the SQL comes from",
      "items": [
        "Built in the browser by sql/builder.ts from the screen state",
        "Values are escaped; column names must exist in the view",
        "The data source expands $__timeFilter, so StarRocks prunes hourly partitions"
      ]
    },
    {
      "dot": "amber",
      "title": "Side paths",
      "items": [
        "A trace id found in a line links to the tenant's Tempo in Explore",
        "StarRocks fetches IDAM's JWKS at each new login to verify the JWT"
      ]
    }
  ]
