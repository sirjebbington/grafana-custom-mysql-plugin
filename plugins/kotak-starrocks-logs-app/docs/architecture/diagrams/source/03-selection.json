  "cards": [
    {
      "dot": "cyan",
      "title": "Data source",
      "items": [
        "Listed = the configured datasources, or every kotak-starrocks-datasource the user can see",
        "One named in the URL is never replaced: its error or empty list is shown instead",
        "Otherwise the first data source where SHOW TABLES returns views wins"
      ]
    },
    {
      "dot": "emerald",
      "title": "View",
      "items": [
        "The URL's view if the user can read it, else the last one used in this browser (same data source), else the first in name order",
        "The choice is written to the URL and saved in this browser"
      ]
    },
    {
      "dot": "amber",
      "title": "Self-healing",
      "items": [
        "A URL update with an empty ds or view is ignored, it never clears the selection",
        "If the body ever finds no valid view while views exist, it picks one again"
      ]
    }
  ]
