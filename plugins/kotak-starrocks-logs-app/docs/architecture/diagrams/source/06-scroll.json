  "cards": [
    {
      "dot": "cyan",
      "title": "Why exact bounds",
      "items": [
        "$__timeFilter is cut to whole seconds; at about 1.6k lines a second that would skip or repeat lines",
        "So line queries add ts >= microseconds_add(FROM_UNIXTIME(s), us) and ts < (to + 1 ms)",
        "The macro range is widened to whole seconds around them, so partition pruning still applies"
      ]
    },
    {
      "dot": "amber",
      "title": "Limits",
      "items": [
        "Logs display only; Table and JSON show the first lineLimit lines",
        "On a relative range, scrolling up at the top loads lines newer than the newest shown",
        "Loading stops when the oldest line is within 1 s of the range start"
      ]
    }
  ]
