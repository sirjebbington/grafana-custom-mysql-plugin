      "title": "Four queries to the first screen",
      "items": [
        "SHOW TABLES (once per data source tried)",
        "SELECT * ... LIMIT 0 for the column list, cached per data source and view",
        "One GROUP BY for every service's volume, one UNION ALL for the newest lines of the visible page"
