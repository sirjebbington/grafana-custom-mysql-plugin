  "cards": [
    {
      "dot": "cyan",
      "title": "How the time is taken",
      "items": [
        "The line query also returns CAST(observed_timestamp AS VARCHAR) as a hidden __ts field",
        "That exact text (e.g. 2026-11-20 13:25:15.852430) is the anchor, so no millisecond rounding",
        "The window is up to 1 hour each way; each 'load more' moves the anchor to the edge line"
      ]
    },
    {
      "dot": "amber",
      "title": "What is and is not included",
      "items": [
        "Only lines of the same pod, regardless of the current filters, like Loki's context",
        "Other lines with exactly the anchor's microsecond are left out (strict < and >)",
        "No $__timeFilter: the bounds are constants on observed_timestamp, derived from the anchor"
      ]
    }
  ]
