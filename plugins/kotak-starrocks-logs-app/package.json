{
  "name": "kotak-starrocks-logs-app",
  "version": "0.2.0",
  "description": "Logs Drilldown for StarRocks log views. Queries run through kotak-starrocks-datasource as the signed-in user.",
  "private": true,
  "scripts": {
    "build": "webpack -c ./webpack.config.ts --env production",
    "dev": "webpack -w -c ./webpack.config.ts --env development",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4 --forceExit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "lint:fix": "npm run lint -- --fix && prettier --write --list-different .",
    "e2e": "playwright test",
    "sign": "sign-plugin",
    "e2e:smoke": "jest -c jest.smoke.config.js --runInBand"
  },
  "author": "Kotak Observability",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@grafana/eslint-config": "^10.0.0",
    "@grafana/sign-plugin": "^3.3.3",
    "@grafana/tsconfig": "^2.2.0",
    "@playwright/test": "1.52.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/core": "^1.15.0",
    "@swc/helpers": "^0.5.0",
    "@swc/jest": "^0.2.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "16.2.0",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "^30.0.0",
    "@types/lodash": "4.17.15",
    "@types/node": "^22.12.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.0",
    "diagnostics-webpack-plugin": "^1.0.1",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-jsdoc": "^52.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "glob": "^11.1.0",
    "identity-obj-proxy": "^3.0.0",
    "imports-loader": "^5.0.0",
    "intersection-observer": "^0.12.2",
    "jest": "^30.5.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^30.5.0",
    "prettier": "^3.6.0",
    "replace-in-file-webpack-plugin": "^1.0.0",
    "sass": "^1.89.0",
    "sass-loader": "^16.0.0",
    "semver": "^7.7.0",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.0",
    "terser-webpack-plugin": "^5.3.0",
    "ts-node": "^10.9.0",
    "typescript": "5.9.2",
    "webpack": "^5.106.0",
    "webpack-cli": "^6.0.0",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-subresource-integrity": "^5.1.0",
    "webpack-virtual-modules": "^0.6.2"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@emotion/css": "11.13.5",
    "@grafana/data": "12.0.1",
    "@grafana/e2e-selectors": "12.0.1",
    "@grafana/runtime": "12.0.1",
    "@grafana/scenes": "6.20.2",
    "@grafana/schema": "12.0.1",
    "@grafana/ui": "12.0.1",
    "lodash": "4.17.21",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.2",
    "rxjs": "7.8.1",
    "tslib": "2.8.1"
  },
  "packageManager": "npm@10.9.3"
}
